# Нусха олинг:  cp .env.example .env   ва қийматларни ўзгартиринг.

# Серверингизнинг ички тармоқдаги IP манзили. Шу манзилга HTTPS сертификати автоматик чиқарилади.
SERVER_IP=10.42.0.231
# Қўшимча ички номлар (ихтиёрий, бўш жой билан): масалан  test.ichki
SERVER_NAMES=
# Ташқи порт (HTTPS). 443 банд бўлса, бошқасини ёзинг, масалан 8443
PORT=443

# База пароли — албатта ўзгартиринг
POSTGRES_PASSWORD=bu-yerga-kuchli-parol

# Биринчи ишга туширишда яратиладиган суперадмин
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=bu-yerga-kuchli-parol

# Safe Exam Browser: true — номзод саҳифалари фақат SEB орқали очилади
REQUIRE_SEB=true
# SEB Config Tool'даги "Config Key" (ихтиёрий, қўшимча ҳимоя)
SEB_CONFIG_KEYS=

# Номзод расмлари неча кундан кейин ўчирилади
PHOTO_RETENTION_DAYS=180

# Махфий калит: бўш қолса, автоматик яратилади ва сақланади
SECRET_KEY=
